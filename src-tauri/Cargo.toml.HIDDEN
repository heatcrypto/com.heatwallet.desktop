[package]
name = "heat_wallet"
version = "2.10.18"
description = "Crypto Wallet Communicator"
authors = ["you"]
license = ""
repository = ""
edition = "2021"
rust-version = "1.77.2"

# See more keys and their definitions at https://doc.rust-lang.org/cargo/reference/manifest.html

[lib]
name = "app_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
tauri-build = { version = "2.0.6", features = [] }

[dependencies]
serde_json = "1.0"
serde = { version = "1.0", features = ["derive"] }
log = "0.4"
tauri = { version = "2.3.1", features = ["devtools"]  }
tauri-plugin-log = "2.3.1"
tauri-plugin-updater = { version = "2.5.0", features = ["rustls-tls"] }
tauri-plugin-dialog = "2.2.0"
tauri-plugin-process = "2.2.0"
once_cell = "1.21.1"
tokio = { version = "1.36", features = ["time", "macros", "rt"] }

# https://github.com/jhpratt/deranged/issues/18
deranged = "=0.4.0"